<Window x:Class="Zyvora.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZYVORA — Console Hub" Width="1280" Height="850" MinWidth="1060" MinHeight="720" Background="#080F1E" Foreground="#ECF4FF" FontFamily="Segoe UI" FontSize="14">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Z Y V O R A" FontSize="32" FontWeight="Bold"/><TextBlock Text="CONSOLE HUB   /   Votre console. Votre espace." Foreground="{StaticResource Muted}" Margin="0,6,0,22"/></StackPanel><Border Grid.Column="1" Background="#172D3B" CornerRadius="20" Padding="18,9" VerticalAlignment="Top"><TextBlock x:Name="ConnectionBadge" Text="●  Hors connexion" Foreground="#7DE7F4"/></Border></Grid>
<Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="20" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ADRESSE LOCALE" Foreground="{StaticResource Muted}"/><TextBox x:Name="HostBox" Text=""/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FTP" Foreground="{StaticResource Muted}"/><TextBox x:Name="FtpPortBox" Text="1337"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MANAGER HTTP" Foreground="{StaticResource Muted}"/><TextBox x:Name="ManagerPortBox" Text="8084"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="LOADER TCP" Foreground="{StaticResource Muted}"/><TextBox x:Name="LoaderPortBox" Text="9021"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="FIRMWARE¹" Foreground="{StaticResource Muted}"/><TextBox x:Name="FirmwareBox" Text="13.60"/></StackPanel><StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Découvrir" Click="Discover_Click"/><Button Content="Connecter" Background="#226B88" Click="Connect_Click"/></StackPanel></Grid></Border>
<TabControl Grid.Row="2" Background="{StaticResource Panel}" BorderThickness="0" Foreground="#ECF4FF">
<TabItem Header="Explorateur"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Ouvrir" Click="Refresh_Click"/><Button DockPanel.Dock="Right" Content="↑ Parent" Click="Parent_Click"/><TextBox x:Name="RemotePath" Text="/data"/></DockPanel><WrapPanel Grid.Row="1"><Button Content="Envoyer des fichiers" Click="Upload_Click"/><Button Content="Télécharger" Click="Download_Click"/><Button Content="Nouveau dossier" Click="Mkdir_Click"/><Button Content="Renommer" Click="Rename_Click"/><Button Content="Modifier texte" Click="Edit_Click"/><Button Content="Supprimer" Click="Delete_Click"/></WrapPanel><DataGrid Grid.Row="2" x:Name="FilesGrid" MouseDoubleClick="Files_DoubleClick" Margin="0,12,0,10"><DataGrid.Columns><DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" MinWidth="450"/><DataGridCheckBoxColumn Header="Dossier" Binding="{Binding IsDirectory}" Width="90"/><DataGridTextColumn Header="Octets" Binding="{Binding Size}" Width="140"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Text="FTP en clair sur réseau local. Les transferts terminés sont confirmés par le serveur ; une exécution ou installation demande une validation séparée." Foreground="{StaticResource Muted}"/></Grid></TabItem>
<TabItem Header="Payloads"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Des sources explicites. Des compatibilités traçables." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="¹ Firmware saisi par l’utilisateur. Compatibilité déclarée par la source ≠ validation sur votre console." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/></StackPanel><DataGrid x:Name="CatalogGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Payload" Binding="{Binding Name}" Width="*" MinWidth="300"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="160"/><DataGridTextColumn Header="Validation" Binding="{Binding Validation}" Width="170"/><DataGridTextColumn Header="Licence" Binding="{Binding License}" Width="110"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><WrapPanel><Button Content="Source et compatibilité" Click="CatalogInfo_Click"/><Button Content="Télécharger + vérifier SHA-256" Click="CatalogDownload_Click"/><Button Content="Envoyer ELF/BIN au loader" Click="Payload_Click"/><Button Content="Stocker dans Payload Manager" Click="ManagerUpload_Click"/></WrapPanel><TextBlock Text="Envoi TCP : réception des octets uniquement, aucune preuve d’exécution. Stockage HTTP : confirmation du service, sans lancement automatique." Foreground="{StaticResource Muted}"/></StackPanel></Grid></TabItem>
<TabItem Header="Bibliothèque"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Vos fichiers locaux • PKG / ELF / BIN" FontSize="24"/><WrapPanel Grid.Row="1" Margin="0,12"><Button Content="Indexer un dossier" Click="Library_Click"/><Button Content="Calculer SHA-256" Click="LibraryHash_Click"/><Button Content="Transférer la sélection par FTP" Click="LibraryUpload_Click"/></WrapPanel><DataGrid x:Name="LibraryGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*" MinWidth="250"/><DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="80"/><DataGridTextColumn Header="Octets" Binding="{Binding Length}" Width="140"/><DataGridTextColumn Header="Chemin local" Binding="{Binding FullName}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Sauvegardes"><StackPanel Margin="24"><TextBlock Text="Copier avant de modifier." FontSize="26"/><TextBlock Text="Copie récursive des fichiers accessibles par FTP, avec manifeste SHA-256 local. Une copie FTP ne déchiffre pas une sauvegarde de jeu et ne certifie pas sa restauration." Margin="0,12" Foreground="{StaticResource Muted}"/><TextBlock Text="Répertoire distant à sauvegarder"/><TextBox x:Name="BackupPath" Text="/data/etaHEN"/><Button Content="Créer une copie de sécurité" HorizontalAlignment="Left" Click="Backup_Click"/><Button Content="Vérifier une copie de sécurité" HorizontalAlignment="Left" Click="VerifyBackup_Click"/></StackPanel></TabItem>
<TabItem Header="Diagnostic"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Comprendre les journaux etaHEN" FontSize="24"/><TextBox Grid.Row="1" x:Name="DiagnosticInput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,16,0,8"/><WrapPanel Grid.Row="2"><Button Content="Analyser le texte" Click="Analyze_Click"/><Button Content="Importer un journal local" Click="ImportLog_Click"/></WrapPanel><TextBlock Grid.Row="3" x:Name="DiagnosticResult" Foreground="#7DE7F4" Margin="0,12"/></Grid></TabItem>
<TabItem Header="Réglages"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Un espace qui vous ressemble." FontSize="24"/><WrapPanel Margin="0,16"><Button Content="Thème Océan" Click="Ocean_Click"/><Button Content="Thème Améthyste" Click="Purple_Click"/><Button Content="Réduire les animations" Click="Motion_Click"/></WrapPanel><TextBlock Text="Identifiants FTP (non enregistrés)"/><TextBox x:Name="UserBox" Text="anonymous"/><PasswordBox x:Name="PasswordBox" Password="zyvora@local" Padding="10"/><Button Content="Enregistrer les ports et préférences" HorizontalAlignment="Left" Click="SaveSettings_Click"/><TextBlock Text="Diffusion et mises à jour" FontSize="20" Margin="0,24,0,8"/><TextBlock Text="La publication GitHub n'est pas encore configurée. Les mises à jour automatiques ne sont pas actives dans cette version. Aucun téléchargement ni lancement de code en arrière-plan." Foreground="{StaticResource Muted}"/><TextBlock Text="Étapes suivantes" FontSize="20" Margin="0,24,0,8"/><TextBlock Text="Installation PKG distante, cheats/mods, jaquettes, plugins et application PS5 installable : non disponibles dans 0.1.0. Consultez le rapport de validation pour les limites et les essais nécessaires." Foreground="{StaticResource Muted}"/><Button Content="Rapport des fonctionnalités" HorizontalAlignment="Left" Click="Status_Click"/></StackPanel></ScrollViewer></TabItem>
</TabControl>
<Border Grid.Row="3" Margin="0,18,0,0" Background="#101B2E" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Prêt. Connectez un service FTP pour commencer." VerticalAlignment="Center"/><ProgressBar x:Name="Progress" Grid.Column="1" Height="6" Margin="10,0,16,0" Maximum="100" Foreground="#7DE7F4"/><Button Grid.Column="2" Content="Annuler" Click="Cancel_Click"/></Grid></Border>
</Grid></Window>
