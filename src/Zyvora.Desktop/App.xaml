<Application x:Class="Zyvora.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="Panel" Color="#141E31"/><SolidColorBrush x:Key="Ink" Color="#ECF4FF"/><SolidColorBrush x:Key="Muted" Color="#99ACC6"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#243655"/><Setter Property="Foreground" Value="#ECF4FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34527D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0A1324"/><Setter Property="Foreground" Value="#ECF4FF"/><Setter Property="CaretBrush" Value="#7DE7F4"/><Setter Property="BorderBrush" Value="#334764"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#B7CBE4"/><Setter Property="Background" Value="#141E31"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#7DE7F4"/><Setter TargetName="TabBorder" Property="Background" Value="#233552"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="#101A2B"/><Setter Property="Foreground" Value="#ECF4FF"/><Setter Property="RowBackground" Value="#101A2B"/><Setter Property="AlternatingRowBackground" Value="#17243A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#243552"/><Setter Property="Foreground" Value="#99ACC6"/><Setter Property="Padding" Value="12"/></Style>
</Application.Resources></Application>
